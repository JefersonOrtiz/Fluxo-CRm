{
  "name": "JF System CRM",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-bookworm",
  "remoteUser": "node",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "JF System CRM",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "npm ci --prefix backend",
  "postStartCommand": "node .devcontainer/start.mjs",
  "waitFor": "postCreateCommand"
}
