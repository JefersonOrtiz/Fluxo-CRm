# Copie para .env e substitua todos os valores marcados antes de subir o Compose.
# Gere os segredos conforme docs/configuration.md. Nunca reutilize estes placeholders.
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_JWT_FORTE
ENCRYPTION_KEY=SUBSTITUIR_POR_CHAVE_DE_CRIPTOGRAFIA_FORTE
META_VERIFY_TOKEN=SUBSTITUIR_POR_TOKEN_META

# Somente para o servidor SQLite legado. Vazio usa ./data.
# Em instâncias Railway legadas com Volume, use /data.
DATA_DIR=
