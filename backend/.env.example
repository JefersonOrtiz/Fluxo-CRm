PORT=3001
DATABASE_URL=postgresql://fluxo:fluxo_local@localhost:5432/fluxo_crm
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatorio
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000
META_VERIFY_TOKEN=

# Endereço público HTTPS do CRM. O webhook deve ser acessível pelo Mercado Pago.
# Vazio mantém pagamentos desabilitados; nunca use URL do provedor recebida do navegador.
APP_PUBLIC_URL=
# Public Key pode ir ao navegador. As duas chaves abaixo são exclusivas do servidor.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
