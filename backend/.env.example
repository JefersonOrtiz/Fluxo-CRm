PORT=3001
DATABASE_URL=postgresql://fluxo:fluxo_local@localhost:5432/fluxo_crm
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_JWT_FORTE
# Deve representar exatamente 32 bytes em Base64. Consulte docs/configuration.md.
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:8080
META_VERIFY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Padrão seguro para desenvolvimento: simulação local, sem chamadas pagas.
AI_PROVIDER=mock
# A OpenAI só pode ser ativada explicitamente com AI_PROVIDER=openai e uma chave válida.
OPENAI_ENABLED=false
